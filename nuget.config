<?xml version="1.0" encoding="utf-8"?>
<!-- Restore only from nuget.org (SECURITY_AND_PRIVACY_DESIGN §3, supply chain). -->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
