<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Unit tests run anywhere. Tests marked [Trait("Category", "Integration")] need an interactive Windows
    desktop session. spikes/README.md shows the test filter that excludes them.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="xunit.v3" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\Halo.Spikes.Measurement\Halo.Spikes.Measurement.csproj" />
    <ProjectReference Include="..\..\src\Halo.Spikes.Windows\Halo.Spikes.Windows.csproj" />
    <ProjectReference Include="..\..\src\Halo.Spikes.Overlay\Halo.Spikes.Overlay.csproj" />
  </ItemGroup>
</Project>
